# --- Database ---
DATABASE_URL=postgresql://studio:studio@localhost:5432/studio

# --- AI ---
# "anthropic" in production, "mock" for local demos and tests (no API key needed)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL_SMART=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5

# --- Storage ---
# "local" writes to STORAGE_DIR; "s3" works with AWS S3, Cloudflare R2, MinIO
STORAGE_DRIVER=local
STORAGE_DIR=./data/storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=studio
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

# --- Video worker ---
PYTHON_BIN=python3
WHISPER_MODEL=small
SUBTITLE_FONT=Cairo

# --- App ---
APP_URL=http://localhost:3000
SESSION_DAYS=30
