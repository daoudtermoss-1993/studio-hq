# --- Database ---
DATABASE_URL=postgresql://studio:studio@localhost:5432/studio

# --- AI ---
# "anthropic" in production, "mock" for local demos and tests (no API key needed)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL_SMART=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5

# --- Viral lab ---
# YouTube Data API v3 key (Google Cloud console → APIs → YouTube Data API v3). Without it, only web search is used.
YOUTUBE_API_KEY=

# --- Digital twin (avatar videos) ---
# HeyGen API key; create your avatar + voice once in HeyGen, then paste their IDs in the app's settings.
HEYGEN_API_KEY=
HEYGEN_API_BASE=https://api.heygen.com

# --- Engineering division (problem hunting + connectors) ---
# Encrypts MCP connector tokens at rest. Required in production: `openssl rand -hex 32`
APP_SECRET=
# Optional: higher GitHub search limits (a fine-grained token with public read only is enough)
GITHUB_TOKEN=
# Optional: Reddit search needs an app (reddit.com/prefs/apps, type "script"), client-credentials only
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional: higher Stack Exchange quota
STACKEXCHANGE_KEY=

# --- Opportunities division (finding businesses + website audits) ---
# Google Cloud key with "Places API (New)" enabled. Without it the scout uses web search instead.
GOOGLE_MAPS_API_KEY=
# Optional: PageSpeed Insights works keyless at a low quota; a key (same Google Cloud project) raises it.
PAGESPEED_API_KEY=

# --- Storage ---
# "local" writes to STORAGE_DIR; "s3" works with AWS S3, Cloudflare R2, MinIO
STORAGE_DRIVER=local
STORAGE_DIR=./data/storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=studio
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

# --- Video worker ---
PYTHON_BIN=python3
WHISPER_MODEL=small
SUBTITLE_FONT=Cairo

# --- App ---
APP_URL=http://localhost:3000
SESSION_DAYS=30
