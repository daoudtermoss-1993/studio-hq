{
  "name": "studio-hq",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @studio/web --filter @studio/worker dev",
    "build": "pnpm --filter @studio/web build",
    "db:generate": "pnpm --filter @studio/db generate",
    "db:migrate": "pnpm --filter @studio/db migrate",
    "worker": "pnpm --filter @studio/worker start",
    "test": "pnpm --filter @studio/core test",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm --filter @studio/web e2e"
  }
}
